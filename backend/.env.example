# Supabase Configuration
# For a direct PostgreSQL connection, set DATABASE_URL instead. The direct
# database role must be able to access the schema created by backend/schema.sql.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# If DATABASE_URL is set, it takes precedence over the Supabase settings below.
SUPABASE_URL=https://your-project.supabase.co
# Use the server-side service_role secret here. Never expose it in frontend code.
SUPABASE_KEY=your-supabase-service-role-secret

# LLM Provider Configuration
# Set LLM_PROVIDER to "openai", "gemini", or "mock" (offline testing without API key)
LLM_PROVIDER=gemini
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Model Configuration
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Vector & RAG Settings
EMBEDDING_DIMENSION=1536
TOP_K_CHUNKS=6
SIMILARITY_THRESHOLD=0.35

# Storage & Brochure Directory
BROCHURES_DIR=../brochures
UPLOAD_DIR=./uploads

# Brochure administration. The ignored backend/admin.env file, when present,
# is loaded first and takes precedence over these template values.
ADMIN_USERNAME=ApexIQ
ADMIN_PASSWORD=replace-with-a-long-random-password

# Comma-separated browser origins. Set the production Vercel URL in Render.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
